# CivicFix API configuration. Copy to .env for local development.
# Full reference: docs/reference/configuration.md
# Never commit a real .env file.

NODE_ENV=development
PORT=5000

# ---- Database (PostgreSQL) -------------------------------------------------
# Either a connection string...
DATABASE_URL=postgres://<username>:<password>@<host>:<port>/<database>
# ...or separate values (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD).
# DATABASE_SSL=true            # hosted databases (Neon, Render external URL, ...)

# Only for `npm test`. Integration tests WIPE this database on every run.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/civicguard_test

# ---- Security ---------------------------------------------------------------
# 32+ random characters (64+ in production): openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_DAYS=30
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=30

# ---- Public URLs ------------------------------------------------------------
# Host and scheme used in photo URLs returned by the API.
API_HOST=localhost:5000
API_PROTOCOL=http
# PUBLIC_API_URL=https://api.example.com   # Google sign-in redirect base
# ADMIN_URL=https://admin.example.com      # where staff return after Google sign-in

# ---- Optional sign-in methods -------------------------------------------------
# Outside production, codes are printed to this log ("log" providers).
# EMAIL_PROVIDER=ses
# EMAIL_FROM=no-reply@example.com
# SMS_PROVIDER=sns
# SMS_SENDER_ID=CIVFIX
# SMS_ENTITY_ID=
# SMS_TEMPLATE_ID=
# AWS_REGION=ap-south-1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Other ------------------------------------------------------------------
# Set to false to skip reverse geocoding (offline development, tests).
# GEOCODING_ENABLED=true
