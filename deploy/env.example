# CivicFix server settings. deploy/setup-server.sh creates /opt/civicfix/.env from this (mode 600, root only)
# and fills in the secrets and addresses. Edit the optional settings, then re-run the script.

# Generated on first run; keep them. Changing POSTGRES_PASSWORD later does not change the database's password.
POSTGRES_PASSWORD=
JWT_SECRET=

# Set by the script from the public address (it also adds COMPOSE_FILE, which selects the standalone or shared overlay)
SITE_ADDRESS=
CORS_ORIGINS=
API_HOST=
API_PROTOCOL=https
PUBLIC_API_URL=
ADMIN_URL=
VITE_API_URL=

# Optional: Google sign-in (redirect URI: https://<address>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
