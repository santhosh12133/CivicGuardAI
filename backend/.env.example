# Backend environment configuration
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (never commit real credentials)
DATABASE_URL=postgres://<username>:<password>@<host>:<port>/<database>

# Use a long random secret (32+ characters; preferably 64+ in production)
JWT_SECRET=replace-with-a-long-random-secret

# Browser origins allowed to call the API. Comma-separated in production.
# Example: https://admin.example.com
CORS_ORIGINS=http://localhost:5173

# Public API host used when constructing uploaded-image URLs.
# Example: api.example.com
API_HOST=localhost:5000
API_PROTOCOL=http

# Production deployments should use HTTPS and a managed object store/CDN
# instead of relying on local filesystem uploads.
